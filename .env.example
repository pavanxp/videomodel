# visual-diversity credentials -- copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real values.
#
# A real environment variable always wins over this file, so an explicit
# `export` during a one-off run is not silently overridden.
#
# The loader walks up from the working directory looking for `.env`, so a file
# at the repository root is found from anywhere inside it. Point somewhere else
# with VD_ENV_FILE=/path/to/.env
#
# Check what is picked up (values are never printed):
#   python -m visual_diversity.settings

# ---------------------------------------------------------------------------
# Object storage.
#
# THREE FAMILIES ARE RECOGNISED, TRIED IN THIS ORDER:
#     digitalocean  DO_SPACES_*     (endpoint required)
#     aws           AWS_*           (endpoint optional -- derived from region)
#     s3            S3_*            (endpoint required)
#
# Credentials resolve AS A SET, never field by field. The first family with both
# an access key and a secret key wins outright, and its endpoint and region come
# from that same family. Any other family is named in a warning and ignored.
#
# So do NOT fill in two families expecting them to combine -- a DO_SPACES key
# pair will never be paired with an AWS_ENDPOINT_URL. That is deliberate: it
# would send your Spaces secret to amazonaws.com.
#
# Fill in ONE family. Only needed to pull clips from a bucket; a manifest of
# local paths needs none of this.
# ---------------------------------------------------------------------------
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_REGION=sfo3
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_BUCKET_URL=https://your-bucket-name.sfo3.digitaloceanspaces.com
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=

# --- or AWS proper (leave the DO_SPACES_ pair blank if you use these) --------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL=              # omit for real S3; boto3 derives it
# AWS_S3_BUCKET=

# --- or any other S3-compatible service (MinIO, Ceph, Wasabi, ...) -----------
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_BUCKET=

# boto3, aws-cli, rclone and ffmpeg read the AWS_* names. To mirror whichever
# family was selected into those names at runtime:
#   python -m visual_diversity.settings --export-aws

# ---------------------------------------------------------------------------
# Paths -- optional. Equivalent to the DEFAULT_* constants in settings.py,
# and these win over them.
# ---------------------------------------------------------------------------
# VD_INPUT_DIR=      # root for relative clip_path values in the manifest
# VD_OUTPUT_DIR=     # where reports land
# VD_CACHE_DIR=      # frames + embeddings
# VD_MANIFEST=       # default manifest, so --manifest can be omitted

# ---------------------------------------------------------------------------
# Stage 12 -- borderline review (GPT-4o vision).
# Only read when borderline_review.enabled is true in the pipeline config.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_BASE_URL=          # for a proxy or Azure-style gateway
# OPENAI_ORG_ID=
